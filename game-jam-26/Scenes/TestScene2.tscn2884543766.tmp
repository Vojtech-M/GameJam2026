[sub_resource type="GDScript" id="GDScript_5rbs6"]
script/source = "extends RigidBody2D

@export var max_speed: float = 300.0  # Zde si nastavte maximální rychlost podle potřeby

var should_reset: bool = false

# Tuto funkci zavolá brána
func reset_ball() -> void:
	should_reset = true

# Toto je fyzikální smyčka přímo v RigidBody2D
func _integrate_forces(state: PhysicsDirectBodyState2D) -> void:
	if should_reset:
		# Nastavíme pozici natvrdo na střed obrazovky
		var center_pos = get_viewport_rect().size / 2
		state.transform = Transform2D(0.0, center_pos)
		
		# Vynulujeme rychlost
		state.linear_velocity = Vector2.ZERO
		state.angular_velocity = 0.0
		
		should_reset = false
		return # Pokud resetujeme, dál už rychlost řešit nemusíme

	# --- OMEZENÍ MAXIMÁLNÍ RYCHLOSTI ---
	if state.linear_velocity.length() > max_speed:
		# Zmenší vektor rychlosti tak, aby odpovídal maximální povolené hodnotě
		state.linear_velocity = state.linear_velocity.normalized() * max_speed
"

